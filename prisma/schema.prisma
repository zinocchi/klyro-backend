generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String   @default("User") // default only backfills legacy rows; register enforces it
  password_hash      String
  monthly_budget     Int?
  language           String   @default("id")
  daily_reminder_time String?
  created_at         DateTime @default(now())
  tasks              Task[]
  habits             Habit[]
  transactions       Transaction[]
  notes              Note[]
  notifications      Notification[]
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String // BUDGET_ALERT | TASK_REMINDER | HABIT_REMINDER | NOTE_REMINDER | DAILY_FINANCE
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(uuid())
  user_id     String
  title       String
  description String?
  due_date    DateTime?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  subtasks    Json         @default("[]")
  reminder_at DateTime?
  created_at  DateTime     @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Transaction {
  id         String          @id @default(uuid())
  user_id    String
  type       TransactionType
  amount     Int // rupiah bulat, tanpa desimal
  category   String
  note       String?
  date       DateTime        @db.Date
  created_at DateTime        @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  content    String
  is_pinned  Boolean  @default(false)
  tag        String?
  remind_at  DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Habit {
  id           String     @id @default(uuid())
  user_id      String
  title        String
  target_days  String[]   // Contoh: ["MON", "WED", "FRI"]
  streak_count Int        @default(0)
  best_streak  Int        @default(0)
  reminder_time String?
  created_at   DateTime   @default(now())

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habit_id  String
  date      DateTime @db.Date
  completed Boolean  @default(false)

  habit Habit @relation(fields: [habit_id], references: [id], onDelete: Cascade)

  @@unique([habit_id, date]) // Mencegah duplikat log di tanggal yang sama
}